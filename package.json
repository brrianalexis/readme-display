{
	"name": "readme-display",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "concurrently \"bunx @tailwindcss/cli -i ./styles/input.css -o ./styles/output.css --watch\" \"next dev\"",
		"build": "bunx @tailwindcss/cli -i ./styles/input.css -o ./styles/output.css && next build",
		"start": "next start",
		"check": "biome check --write",
		"test": "vitest --reporter verbose",
		"test:watch": "vitest --reporter verbose --watch"
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.8",
		"axios": "^1.13.5",
		"next": "^16.1.6",
		"next-themes": "^0.4.6",
		"postcss": "^8.5.6",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"rss-parser": "^3.13.0",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.15",
		"@tailwindcss/cli": "^4.1.18",
		"@tailwindcss/postcss": "^4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.2.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"@vitest/coverage-v8": "^4.0.18",
		"concurrently": "^9.2.1",
		"jsdom": "^28.0.0",
		"msw": "^2.12.10",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.0.18"
	}
}
