{
	"name": "readme-display",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "concurrently \"bunx @tailwindcss/cli -i ./styles/input.css -o ./styles/output.css --watch\" \"next dev\"",
		"build": "bunx @tailwindcss/cli -i ./styles/input.css -o ./styles/output.css && next build",
		"start": "next start",
		"check": "biome check --write",
		"test": "vitest --reporter verbose",
		"test:watch": "vitest --reporter verbose --watch"
	},
	"dependencies": {
		"@fontsource/inter": "^5.1.0",
		"@tailwindcss/cli": "^4.1.18",
		"@tailwindcss/postcss": "^4.1.18",
		"axios": "^1.7.9",
		"next": "15.4.10",
		"next-themes": "^0.4.4",
		"postcss": "^8.4.49",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"rss-parser": "^3.13.0",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.15",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/node": "22.10.2",
		"@types/react": "19.0.2",
		"@types/react-dom": "19.0.2",
		"@vitejs/plugin-react": "^4.3.4",
		"@vitest/coverage-v8": "^2.1.8",
		"concurrently": "^9.1.0",
		"jsdom": "^25.0.1",
		"msw": "^2.7.0",
		"typescript": "5.7.2",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^2.1.8"
	}
}
